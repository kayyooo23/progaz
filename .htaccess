# Убираем .html из адресов страниц
RewriteEngine On

RewriteCond %{HTTPS} =on
RewriteRule ^ - [E=PROTO:https]
RewriteCond %{HTTPS} !=on
RewriteRule ^ - [E=PROTO:http]

# Если кто-то открыл адрес с .html — переадресуем на адрес без него
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ %{ENV:PROTO}://%{HTTP_HOST}/%1 [R=301,L]

# Внутри сервера ищем файл со .html, если в адресе его нет
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# HTML/JS/CSS обновляются часто — не даём браузеру кэшировать их надолго,
# иначе после правок сайта у людей ещё долго открывается старая версия.
# Фото товаров меняются редко, для них кэш оставляем длинным.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/javascript "access plus 1 hour"
  ExpiresByType text/css "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>
